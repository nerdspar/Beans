{
  "name": "beans",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --recursive --filter \"./apps/*\" build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:math": "vitest run .math.test.",
    "test:integration": "vitest run .integration.test.",
    "db:generate": "pnpm --filter @beans/api db:generate",
    "db:migrate": "pnpm --filter @beans/api db:migrate",
    "generate:master-key": "node scripts/generate-master-key.mjs",
    "demo:seed": "pnpm --filter @beans/api demo:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
