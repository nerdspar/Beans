{
  "name": "@beans/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:migrate:test": "tsx --env-file-if-exists=../../.env src/db/migrate.ts --test",
    "dev:seed": "tsx --env-file-if-exists=../../.env src/dev/seed.ts",
    "dev:consolidate": "tsx --env-file-if-exists=../../.env src/dev/consolidate.ts",
    "dev:check-key": "tsx src/dev/check-key.ts"
  },
  "dependencies": {
    "@beans/shared": "workspace:*",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.2",
    "@node-rs/argon2": "^2.0.2",
    "better-auth": "^1.6.25",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.11.0",
    "nodemailer": "^9.0.3",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.4",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.27.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.4"
  }
}
