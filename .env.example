# Beans configuration.
#
# Copy to `.env` and fill in. Every variable is explained; nothing here is optional-by-accident.
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real values.

# =================================================================================================
# Storage
# =================================================================================================

# Where the database files and secrets live. Bind-mounted, so the data sits inside a ZFS dataset
# and is covered by snapshots and replication.
#   On TrueNAS:  /mnt/NAS/Data/beans
#   Elsewhere:   ./data
BEANS_DATA_DIR=/mnt/NAS/Data/beans

# =================================================================================================
# Database
# =================================================================================================

# The Postgres superuser, created by the postgres image on first boot.
# The application deliberately does NOT connect as this role: superusers bypass row-level
# security entirely, which would disable tenant isolation with no visible symptom.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# The role the application actually connects as. Created by docker/initdb/01-init.sh as
# NOSUPERUSER / NOBYPASSRLS. Do not grant it either of those.
BEANS_DB_USER=beans_app
BEANS_DB_PASSWORD=

BEANS_DB_NAME=beans

# Integration tests truncate tables. This must never point at development data.
BEANS_TEST_DB_NAME=beans_test

# Host port for Postgres. Keep this LAN-only — never forward it through the reverse proxy or
# expose it to the internet.
POSTGRES_PORT=5432

# Which host interface to bind that port to. Set this to the TrueNAS LAN address so Postgres is
# not listening on every interface. 0.0.0.0 binds to all.
POSTGRES_BIND=0.0.0.0

# Connection string used by the app and by drizzle-kit.
# For local development against Postgres on TrueNAS, point the host at that box:
#     postgres://beans_app:PASSWORD@192.168.1.x:5432/beans
# Inside docker compose the host is the service name, `db`.
DATABASE_URL=

# Same server, the test database. Used by `pnpm test:integration`.
TEST_DATABASE_URL=

# =================================================================================================
# Encryption
# =================================================================================================

# Path to the master key file — a Docker secret mounted into the container. The key itself is
# NEVER an environment variable and never appears inline in the compose file.
#
# Generate one with:
#     mkdir -p secrets && pnpm generate:master-key > secrets/master.key
#
# *** BACK THIS FILE UP SEPARATELY FROM THE DATABASE. ***
# A Postgres dump without it is permanently unreadable. That is the entire point of the design,
# and it cuts both ways: losing this file loses all financial data, irrecoverably.
MASTER_KEY_FILE=./secrets/master.key

# =================================================================================================
# Application
# =================================================================================================

PORT=3000
APP_PORT=3000
NODE_ENV=development

# The public origin, used for OAuth callbacks, cookie scope, and absolute links in email.
#
# A real hostname with a valid certificate is required, not cosmetic:
#   - Google rejects OAuth redirect URIs on bare IPs and .local names.
#   - Service workers (the installable PWA) require a secure context. localhost is exempt; a LAN
#     IP is not.
PUBLIC_URL=https://beans.nerdspar.com

LOG_LEVEL=info

# =================================================================================================
# Authentication
# =================================================================================================

# Signing secret for sessions and cookies. At least 32 characters, random.
# Generate with:  openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://beans.nerdspar.com

# Google OAuth. Optional per deployment — leave both blank and the Google button is hidden, so a
# self-hosted install works without creating a Google Cloud project.
#
# Authorized redirect URI to register:
#     https://beans.nerdspar.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =================================================================================================
# Email
# =================================================================================================

# Used for password reset and (optionally) household invites.
#
# Everything degrades gracefully when unconfigured: a self-hosted install may have no mail at all,
# and household invites always work as copy-paste links so onboarding never depends on email.
#
# Resend is preferred when RESEND_API_KEY is set; otherwise SMTP_URL is used; if neither is set,
# mail is disabled and the UI says so rather than silently failing.
RESEND_API_KEY=
SMTP_URL=
MAIL_FROM=beans@nerdspar.com
